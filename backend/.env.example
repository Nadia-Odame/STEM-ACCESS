# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection. Works with a local Postgres, or a free hosted
# Postgres such as Neon, Supabase, or Render's managed Postgres.
DATABASE_URL=postgres://username:password@localhost:5432/stem_access

# Set to "true" only if your Postgres provider requires SSL (most hosted
# free-tier providers, e.g. Neon/Render, do).
DATABASE_SSL=false

# Any long random string. Used to sign JWTs — change this before deploying.
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session (JWT) stays valid.
JWT_EXPIRES_IN=7d

# Port the API server listens on.
PORT=5000

# Comma-separated list of allowed frontend origins (CORS). Add your
# deployed frontend URL here once you have one, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://stem-access.vercel.app
CORS_ORIGIN=http://localhost:5173

# Optional. If set, the AI Recommendation Engine (FR4) will call the
# OpenAI API to generate a short natural-language explanation for each
# recommendation. If left blank, the engine still works fully using its
# built-in rule-based skill/interest matching — this key only adds the
# AI-generated "why this was recommended" text on top.
OPENAI_API_KEY=
